<header>
   <h1><a href="/">Home</a></h1>

   {{#if isAuthenticated}}
   <div class="auth-section container flex-row center">
      <p>{{user.email}}</p>
      <a href="/auth/logout"><button class="logout-btn">Log Out</button></a>
   </div>

   {{/if}}

   {{#unless isAuthenticated}}
   <a href="/"><button class="logout-btn">Sign In</button></a>
   {{/unless}}
</header>